# ================================================================
# SAM'SPACE â€” ENVIRONMENT CONFIGURATION (RENDER & VERCEL READY)
# ================================================================

# --- Network & Deployment Settings ---
# Port for the Node.js production server (Render automatically sets this, defaults to 3000)
PORT=10000

# Client origin(s) allowed to access the backend via CORS & Socket.IO.
# For separate frontend deployments, set the frontend origin(s), comma-separated.
CLIENT_URL="http://localhost:3000"

# Public API URL for the frontend to communicate with this backend.
# Leave empty when the frontend and backend use the same origin (including local dev).
# For a separate frontend deployment, set this to the backend origin.
NEXT_PUBLIC_API_URL=

# Public application URL used in generated Telegram links. Set to the deployed app URL.
APP_URL=http://localhost:3000

# --- Cloud Database (PostgreSQL / Neon) ---
# Neon Postgres Connection URL with SSL enabled (?sslmode=require)
# If left empty, falls back to shared local JSON server database (.data/server_db.json)
DATABASE_URL="postgres://username:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Book PDF persistence on Render: mount a persistent disk at /var/data and set BOOK_DATA_DIR=/var/data.
# Locally, book files and OCR cache default to .data/.
# Optional OCR languages use Tesseract language codes, joined with '+', for example eng or eng+fra.
BOOK_DATA_DIR=
PDF_OCR_LANGS=eng
TESSERACT_LANG_PATH=

# Telegram bot credentials (backend only; never add these to NEXT_PUBLIC_* variables).
# In BotFather, copy the bot token. Use the channel's @username or numeric chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
BOOKS_CRON_SECRET=
BRIEFS_CRON_SECRET=
# Set only on the Render Cron service; use your deployed NightPlanner web origin.
NIGHTPLANNER_URL=

# Optional Cloudinary storage for uploaded images and other attachments.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- External Content Sources (Server-Side Secrets) ---
# YouTube Data API v3 key for finding relevant educational videos.
YOUTUBE_API_KEY=

# Podcast Index API key and secret with signed SHA-1 auth headers for finding relevant podcasts.
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=

# ZenQuotes API key (optional; free tier rate-limited with link-back attribution).
ZENQUOTES_API_KEY=

# Descriptive User-Agent for Wikipedia API requests (per Wikimedia Foundation policy).
WIKIPEDIA_USER_AGENT=

# --- Authentication & Session Security ---
# Single-user app password for login and cloud sync authentication
APP_PASSWORD="your-secure-password-here"

# Secret key used for signing session cookies and tokens (at least 32 characters)
SESSION_SECRET="super-secret-random-key-at-least-32-characters-long"

# ================================================================
# AI PROVIDER CONFIGURATION (Server-Side Secrets â€” Never exposed to client)
# ================================================================

# FreeLLMAPI gateway for the moon assistant. Set on Sam'Space backend only.
# Both FREELLM_API_BASE_URL / FREE_LLM_API_URL and FREELLM_API_KEY / FREE_LLM_API_KEY are supported.
FREELLM_API_BASE_URL=https://free-llm-api-7fue.onrender.com/v1
FREELLM_API_KEY=
FREE_LLM_API_URL=https://free-llm-api-7fue.onrender.com/v1
FREE_LLM_API_KEY=
FREE_LLM_MODEL=auto
# Optional rotation keys: FREE_LLM_API_KEY_1 through FREE_LLM_API_KEY_16.
# They are tried in numeric order before falling back to direct providers.

# Google Gemini API Keys (GEMINI_API_KEY_1 through GEMINI_API_KEY_8 supported)
# Verified current models: gemini-2.5-flash, gemini-2.0-flash
GEMINI_API_KEY_1="your-google-gemini-api-key-1"
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
GEMINI_MODEL="gemini-3.5-flash"

# Or single fallback key alias:
GEMINI_API_KEY=""

# Groq Cloud API Keys (GROQ_API_KEY_1 through GROQ_API_KEY_8 supported, keys start with gsk_...)
# Ultra-fast inference & zero-delay responses (openai/gpt-oss-20b, openai/gpt-oss-120b)
GROQ_API_KEY_1="gsk_your-groq-api-key-1"
GROQ_API_KEY_2=""
GROQ_API_KEY_3=""
GROQ_MODEL="openai/gpt-oss-20b"

# Or single fallback key alias:
GROQ_API_KEY=""

# OpenAI text-to-speech; keep this key server-side. 
OPENAI_API_KEY=
TTS_PROVIDER=openai
OPENAI_TTS_MODEL=tts-1

# Optional ElevenLabs and Piper voice providers. Keep all keys server-side.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
PIPER_TTS_URL=
PIPER_VOICE=en_US-lessac-medium
